# Compile a selected module once, sharing its objects between hosts.
include_guard(GLOBAL)
function(pce_add_native_module output)
  cmake_parse_arguments(PCE "" "MODULE;MANIFEST" "" ${ARGN})
  if(PCE_UNPARSED_ARGUMENTS OR NOT PCE_MODULE OR NOT TARGET pce-runtime)
    message(FATAL_ERROR "pce_add_native_module(output MODULE source [MANIFEST manifest]) requires pce-runtime")
  endif()
  get_filename_component(_entry "${PCE_MODULE}" REALPATH BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT EXISTS "${_entry}" OR IS_DIRECTORY "${_entry}")
    message(FATAL_ERROR "Native module source does not exist: ${PCE_MODULE}")
  endif()
  get_filename_component(_folder "${_entry}" DIRECTORY)
  if(NOT PCE_MANIFEST AND EXISTS "${_folder}/module.json")
    set(PCE_MANIFEST "${_folder}/module.json")
  endif()
  set(_sources "${_entry}")
  set(_artifacts "${_entry}")
  set(_manifest "")
  if(PCE_MANIFEST)
    get_filename_component(_manifest "${PCE_MANIFEST}" REALPATH BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${_manifest}" OR IS_DIRECTORY "${_manifest}")
      message(FATAL_ERROR "Native module manifest does not exist: ${PCE_MANIFEST}")
    endif()
    file(SIZE "${_manifest}" _size)
    if(_size GREATER 67108864)
      message(FATAL_ERROR "Native module manifest exceeds 64 MiB")
    endif()
    file(READ "${_manifest}" _json)
    foreach(_field schema runtime_abi)
      string(JSON _type TYPE "${_json}" ${_field})
      string(JSON _value GET "${_json}" ${_field})
      if(NOT _type STREQUAL "NUMBER" OR
         (_field STREQUAL "schema" AND NOT _value STREQUAL "1") OR
         (_field STREQUAL "runtime_abi" AND NOT _value STREQUAL "12"))
        message(FATAL_ERROR "Unsupported native module ${_field}")
      endif()
    endforeach()
    string(JSON _tu_type ERROR_VARIABLE _tu_error TYPE "${_json}" translation_units)
    string(JSON _header_type ERROR_VARIABLE _header_error TYPE "${_json}" generated_headers)
    if(NOT _tu_error OR NOT _header_error)
      if(NOT _tu_type STREQUAL "ARRAY" OR NOT _header_type STREQUAL "ARRAY")
        message(FATAL_ERROR "Native module requires translation_units and generated_headers arrays")
      endif()
      set(_sources "")
      set(_seen "")
      get_filename_component(_manifest_folder "${_manifest}" DIRECTORY)
      foreach(_field translation_units generated_headers)
        string(JSON _count LENGTH "${_json}" ${_field})
        if((_field STREQUAL "translation_units" AND (_count LESS 1 OR _count GREATER 65537)) OR
           (_field STREQUAL "generated_headers" AND _count GREATER 256))
          message(FATAL_ERROR "Invalid native module ${_field} count")
        endif()
        if(_count GREATER 0)
          math(EXPR _last "${_count}-1")
          foreach(_index RANGE ${_last})
            string(JSON _type TYPE "${_json}" ${_field} ${_index})
            string(JSON _length LENGTH "${_json}" ${_field} ${_index})
            if(NOT _type STREQUAL "OBJECT" OR NOT _length EQUAL 2)
              message(FATAL_ERROR "Invalid native module artifact record")
            endif()
            foreach(_key file sha256)
              string(JSON _type TYPE "${_json}" ${_field} ${_index} ${_key})
              string(JSON _${_key} GET "${_json}" ${_field} ${_index} ${_key})
              if(NOT _type STREQUAL "STRING")
                message(FATAL_ERROR "Native artifact ${_key} must be a string")
              endif()
            endforeach()
            string(LENGTH "${_sha256}" _hash_length)
            string(LENGTH "${_file}" _name_length)
            if(NOT _file MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$" OR _name_length GREATER 128 OR
               NOT _sha256 MATCHES "^[0-9a-f]+$" OR NOT _hash_length EQUAL 64 OR
               (_field STREQUAL "translation_units" AND NOT _file MATCHES "[.]cpp$") OR
               (_field STREQUAL "generated_headers" AND NOT _file MATCHES "[.]hpp$"))
              message(FATAL_ERROR "Unsafe native module artifact name or SHA-256")
            endif()
            string(TOLOWER "${_file}" _folded)
            if(_folded MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|$)")
              message(FATAL_ERROR "Reserved native module artifact name: ${_file}")
            endif()
            if(_folded IN_LIST _seen)
              message(FATAL_ERROR "Duplicate native module artifact: ${_file}")
            endif()
            list(APPEND _seen "${_folded}")
            set(_path "${_manifest_folder}/${_file}")
            if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}")
              message(FATAL_ERROR "Missing or linked native module artifact: ${_file}")
            endif()
            file(SHA256 "${_path}" _actual)
            if(NOT _actual STREQUAL _sha256)
              message(FATAL_ERROR "Native module artifact SHA-256 mismatch: ${_file}")
            endif()
            list(APPEND _artifacts "${_path}")
            if(_field STREQUAL "translation_units")
              list(APPEND _sources "${_path}")
            endif()
          endforeach()
        endif()
      endforeach()
      if(NOT _entry IN_LIST _sources)
        message(FATAL_ERROR "Native module entry is absent from translation_units")
      endif()
    endif()
    list(APPEND _artifacts "${_manifest}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_artifacts})
  string(SHA256 _identity "${_entry}|${_manifest}")
  set(_target "pce-module-${_identity}")
  if(NOT TARGET ${_target})
    add_library(${_target} OBJECT ${_sources})
    target_link_libraries(${_target} PUBLIC pce-runtime)
    set_target_properties(${_target} PROPERTIES CXX_EXTENSIONS OFF)
  endif()
  set(${output} "${_target}" PARENT_SCOPE)
endfunction()

function(pce_add_consumer target)
  set(_PCE_CONSUMER_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  cmake_parse_arguments(PCE "DESKTOP" "MODULE;MANIFEST" "" ${ARGN})
  if(PCE_UNPARSED_ARGUMENTS OR NOT PCE_MODULE)
    message(FATAL_ERROR "pce_add_consumer(target MODULE source [MANIFEST manifest] [DESKTOP])")
  endif()
  if(NOT IS_ABSOLUTE "${PCE_MODULE}")
    get_filename_component(PCE_MODULE "${PCE_MODULE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  if(NOT EXISTS "${PCE_MODULE}" OR NOT TARGET pce-runtime)
    message(FATAL_ERROR "Consumer requires an existing module and pce-runtime")
  endif()
  pce_add_native_module(_module MODULE "${PCE_MODULE}" MANIFEST "${PCE_MANIFEST}")
  add_executable(${target} "${_PCE_CONSUMER_ROOT}/runtime/src/headless.cpp")
  target_link_libraries(${target} PRIVATE ${_module})
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  if(PCE_DESKTOP)
    if(NOT TARGET pce-desktop-host)
      message(FATAL_ERROR "Consumer DESKTOP requires PCE_BUILD_DESKTOP=ON")
    endif()
    target_compile_definitions(${target} PRIVATE PCE_DESKTOP=1)
    target_link_libraries(${target} PRIVATE pce-desktop-host)
    if(WIN32 AND TARGET SDL3::SDL3-shared)
      add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        $<TARGET_FILE:SDL3::SDL3-shared> $<TARGET_FILE_DIR:${target}> VERBATIM)
    endif()
  else()
    target_link_libraries(${target} PRIVATE pce-runtime)
  endif()
endfunction()
