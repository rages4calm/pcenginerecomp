# Embed one explicitly selected generated module in the shared runtime/host.
include_guard(GLOBAL)
function(pce_add_consumer target)
  set(_PCE_CONSUMER_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..")
  cmake_parse_arguments(PCE "DESKTOP" "MODULE" "" ${ARGN})
  if(PCE_UNPARSED_ARGUMENTS OR NOT PCE_MODULE)
    message(FATAL_ERROR "pce_add_consumer(target MODULE source [DESKTOP])")
  endif()
  if(NOT IS_ABSOLUTE "${PCE_MODULE}")
    get_filename_component(PCE_MODULE "${PCE_MODULE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  if(NOT EXISTS "${PCE_MODULE}" OR NOT TARGET pce-runtime)
    message(FATAL_ERROR "Consumer requires an existing module and pce-runtime")
  endif()
  add_executable(${target} "${_PCE_CONSUMER_ROOT}/runtime/src/headless.cpp" "${PCE_MODULE}")
  if(PCE_DESKTOP)
    if(NOT TARGET pce-desktop-host)
      message(FATAL_ERROR "Consumer DESKTOP requires PCE_BUILD_DESKTOP=ON")
    endif()
    target_compile_definitions(${target} PRIVATE PCE_DESKTOP=1)
    target_link_libraries(${target} PRIVATE pce-desktop-host)
    if(WIN32 AND TARGET SDL3::SDL3-shared)
      add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        $<TARGET_FILE:SDL3::SDL3-shared> $<TARGET_FILE_DIR:${target}> VERBATIM)
    endif()
  else()
    target_link_libraries(${target} PRIVATE pce-runtime)
  endif()
endfunction()
