# Post-link Windows PE dependency closure. CMake 3.20-compatible script mode.
cmake_minimum_required(VERSION 3.20)
foreach(_required PCE_EXECUTABLE PCE_ANALYSIS_DIR PCE_COMPILER_DIRECTORY PCE_DEPENDENCY_TOOL PCE_DEPENDENCY_COMMAND)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing runtime dependency parameter: ${_required}")
  endif()
endforeach()
if(NOT EXISTS "${PCE_EXECUTABLE}" OR IS_DIRECTORY "${PCE_EXECUTABLE}")
  message(FATAL_ERROR "Linked consumer executable is missing")
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "${PCE_DEPENDENCY_TOOL}")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${PCE_DEPENDENCY_COMMAND}")

# CMake regexes are case-sensitive; Windows path spelling is not. Escape each
# literal character of the actual system root, preserving arbitrary locations.
function(_pce_path_regex output path)
  file(TO_CMAKE_PATH "${path}" _path)
  set(_special "." "+" "*" "(" ")" "^" "$" "?" "[" "]" "|" "\\")
  set(_regex "")
  string(LENGTH "${_path}" _length)
  if(_length GREATER 0)
    math(EXPR _last "${_length}-1")
    foreach(_index RANGE ${_last})
      string(SUBSTRING "${_path}" ${_index} 1 _char)
      string(TOLOWER "${_char}" _lower)
      string(TOUPPER "${_char}" _upper)
      if(_char STREQUAL "/")
        string(APPEND _regex "[/\\\\]")
      elseif(NOT _lower STREQUAL _upper)
        string(APPEND _regex "[${_lower}${_upper}]")
      else()
        list(FIND _special "${_char}" _escape)
        if(_escape EQUAL -1)
          string(APPEND _regex "${_char}")
        else()
          string(APPEND _regex "\\${_char}")
        endif()
      endif()
    endforeach()
  endif()
  set(${output} "${_regex}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ENV{SystemRoot} OR "$ENV{SystemRoot}" STREQUAL "")
  message(FATAL_ERROR "Windows runtime dependency resolution requires SystemRoot")
endif()
file(REAL_PATH "$ENV{SystemRoot}" _system_root)
_pce_path_regex(_system_regex "${_system_root}")
set(_directories "${PCE_COMPILER_DIRECTORY}" ${PCE_LINK_DIRECTORIES})
if(PCE_SDL_RUNTIME)
  if(NOT EXISTS "${PCE_SDL_RUNTIME}" OR IS_DIRECTORY "${PCE_SDL_RUNTIME}")
    message(FATAL_ERROR "Selected SDL runtime DLL is missing")
  endif()
  get_filename_component(_sdl_directory "${PCE_SDL_RUNTIME}" DIRECTORY)
  list(PREPEND _directories "${_sdl_directory}")
endif()
list(REMOVE_DUPLICATES _directories)

# Resolve next to an EXE and the explicitly selected SDL runtime. Old DLLs from
# the output directory must not shadow the currently selected SDK/compiler.
file(SHA256 "${PCE_EXECUTABLE}" _executable_hash)
set(_analysis_identity "${_executable_hash}")
if(PCE_SDL_RUNTIME)
  file(SHA256 "${PCE_SDL_RUNTIME}" _sdl_hash)
  string(APPEND _analysis_identity "-${_sdl_hash}")
endif()
set(PCE_ANALYSIS_DIR "${PCE_ANALYSIS_DIR}/${_analysis_identity}")
file(MAKE_DIRECTORY "${PCE_ANALYSIS_DIR}")
get_filename_component(_name "${PCE_EXECUTABLE}" NAME)
set(_analysis_executable "${PCE_ANALYSIS_DIR}/${_name}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PCE_EXECUTABLE}" "${_analysis_executable}"
  RESULT_VARIABLE _copied)
if(NOT _copied EQUAL 0)
  message(FATAL_ERROR "Cannot prepare runtime dependency analysis")
endif()
if(PCE_SDL_RUNTIME)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${PCE_SDL_RUNTIME}" "${PCE_ANALYSIS_DIR}"
    RESULT_VARIABLE _copied)
  if(NOT _copied EQUAL 0)
    message(FATAL_ERROR "Cannot stage the selected SDL runtime for dependency analysis")
  endif()
endif()
file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES "${_analysis_executable}"
  DIRECTORIES ${_directories}
  PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
  POST_EXCLUDE_REGEXES "^${_system_regex}[/\\\\]"
  RESOLVED_DEPENDENCIES_VAR _resolved
  UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_unresolved)
  message(FATAL_ERROR "Unresolved consumer runtime DLLs: ${_unresolved}")
endif()
if(_conflicts_FILENAMES)
  message(FATAL_ERROR "Conflicting consumer runtime DLLs: ${_conflicts_FILENAMES}")
endif()
get_filename_component(_destination "${PCE_EXECUTABLE}" DIRECTORY)
foreach(_dependency IN LISTS _resolved)
  get_filename_component(_filename "${_dependency}" NAME)
  set(_output "${_destination}/${_filename}")
  if(IS_SYMLINK "${_output}" OR IS_DIRECTORY "${_output}")
    message(FATAL_ERROR "Runtime DLL destination is not an ordinary file: ${_filename}")
  endif()
endforeach()
foreach(_dependency IN LISTS _resolved)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_dependency}" "${_destination}"
    RESULT_VARIABLE _copied)
  if(NOT _copied EQUAL 0)
    message(FATAL_ERROR "Cannot package consumer runtime DLL: ${_dependency}")
  endif()
endforeach()
